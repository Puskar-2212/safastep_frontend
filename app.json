{
  "expo": {
    "name": "Safastep",
    "slug": "Safastep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/safastep_logo.png",
    "scheme": "Safastep",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/safastep_logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/safastep_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/safastep_logo.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/safastep_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    }
  }
}
